    }
    FLIGHT_LEG {
      bigint leg_id PK
      varchar flight_number FK
    }
    RESERVATION_LEG {
      bigint reservation_id PK, FK
      bigint leg_id PK, FK
    }
    CALENDAR_DATE {
      date calendar_date PK
